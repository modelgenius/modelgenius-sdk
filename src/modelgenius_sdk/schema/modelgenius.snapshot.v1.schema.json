{
  "$defs": {
    "CapturedOutput": {
      "description": "Actual production output supplied with an uploaded snapshot.\n\nOptional: when the customer provides the response their baseline model\nproduced, ModelGenius can score it directly instead of replaying the\nbaseline. `request_timestamp`/`response_timestamp` are required whenever a\ncaptured output is present so latency can be derived without a replay.",
      "properties": {
        "api_surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Surface"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output_text": {
          "default": "",
          "title": "Output Text",
          "type": "string"
        },
        "provider_metadata": {
          "additionalProperties": true,
          "title": "Provider Metadata",
          "type": "object"
        },
        "raw_response": {
          "additionalProperties": true,
          "title": "Raw Response",
          "type": "object"
        },
        "request_timestamp": {
          "format": "date-time",
          "title": "Request Timestamp",
          "type": "string"
        },
        "response_timestamp": {
          "format": "date-time",
          "title": "Response Timestamp",
          "type": "string"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_timestamp",
        "response_timestamp"
      ],
      "title": "CapturedOutput",
      "type": "object"
    },
    "Message": {
      "description": "A single message in OpenAI chat format.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            }
          ],
          "title": "Content"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "SnapshotReference": {
      "anyOf": [
        {
          "properties": {
            "output": {
              "not": {
                "enum": [
                  null,
                  "",
                  [],
                  {}
                ]
              }
            }
          },
          "required": [
            "output"
          ]
        },
        {
          "properties": {
            "values": {
              "minProperties": 1,
              "type": "object"
            }
          },
          "required": [
            "values"
          ]
        }
      ],
      "description": "A known-correct answer for this request.\n\nOptional. Unlike `captured_output`, which is the response your current\nmodel produced, a reference is what the answer should be: a label or\ngrade a person assigned, or a vetted output. When a workflow's requests\ncarry references, ModelGenius adds the criterion \"Agrees with your\nreference answer\" and judges every model's output against it.\n\nGive the full answer as `output`, the values a correct answer must\ncontain as `values`, or both: at least one is required.",
      "properties": {
        "importance": {
          "anyOf": [
            {
              "enum": [
                "ranking",
                "must_pass"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What agreement means for the verdict. \"ranking\" (the default) shows each model's agreement next to your current model's and ranks models by it, but never blocks a switch. \"must_pass\" makes agreement a must-pass criterion. It can also be set per workflow before a run.",
          "title": "Importance"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How to compare an output with this reference, in your own words, for example \"labels are case-insensitive; billing and payments count as the same\".",
          "title": "Notes"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The complete known-correct output: text, or the JSON object or list your response format describes.",
          "title": "Output"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the reference came from, for example \"human labels\" or \"expert review\".",
          "title": "Source"
        },
        "values": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only the values a correct output must contain, by field name, for example {\"category\": \"billing\", \"priority\": \"high\"}.",
          "title": "Values"
        }
      },
      "title": "SnapshotReference",
      "type": "object"
    },
    "TokenUsage": {
      "description": "Provider-reported token usage for a captured production response.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "thinking_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/modelgenius/modelgenius-sdk/main/src/modelgenius_sdk/schema/modelgenius.snapshot.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A captured LLM request/response snapshot in the canonical (OpenAI-chat-shaped) ModelGenius upload format. Anthropic Messages-API-shaped records are also accepted at upload time and converted server-side; this schema describes the canonical shape. Unknown top-level fields are permitted and preserved-or-ignored, so v1 evolves additively.",
  "properties": {
    "api_surface": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Surface"
    },
    "captured_output": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapturedOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "format": {
      "const": "modelgenius.snapshot/v1",
      "description": "Optional self-describing format tag. When present it must be \"modelgenius.snapshot/v1\"."
    },
    "frequency_penalty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frequency Penalty"
    },
    "max_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tokens"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "Messages",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "n": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N"
    },
    "presence_penalty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Presence Penalty"
    },
    "provider_params": {
      "additionalProperties": true,
      "title": "Provider Params",
      "type": "object"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Effort"
    },
    "reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional known-correct answer for this request (see SnapshotReference)."
    },
    "response_format": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Format"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "stop": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timestamp"
    },
    "tool_choice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Choice"
    },
    "tools": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    },
    "top_p": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top P"
    },
    "workflow_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Id"
    }
  },
  "required": [
    "messages"
  ],
  "title": "ModelGenius Snapshot (v1)",
  "type": "object"
}
